@model LibraryMainApp.Models.LibraryProfile

@{
    ViewData["Title"] = "Library Profile";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white text-center">
                    <h3>🏛️ Create Library Profile</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="StaffID" class="form-label">Admin (Staff)</label>
                            <select asp-for="StaffID" class="form-control" asp-items="ViewBag.StaffID">
                                <option value="">-- Select Admin --</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Library Name</label>
                            <input asp-for="Name" class="form-control" placeholder="e.g. City Central Library" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Location" class="form-label">Location</label>
                            <input asp-for="Location" class="form-control" placeholder="e.g. 123 Main Street, Melbourne" />
                            <span asp-validation-for="Location" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="OperatingHours" class="form-label">Operating Hours</label>
                            <input asp-for="OperatingHours" class="form-control" placeholder="e.g. Mon-Fri 9am-5pm, Sat 10am-3pm" />
                            <span asp-validation-for="OperatingHours" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Contact Email</label>
                            <input asp-for="Email" class="form-control" placeholder="library@example.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="e.g. 0300000000" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="LoanDurationDays" class="form-label">Loan Duration (Days)</label>
                                <input asp-for="LoanDurationDays" class="form-control" placeholder="e.g. 14" />
                                <span asp-validation-for="LoanDurationDays" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="MaxBorrowableBooks" class="form-label">Max Books Per Member</label>
                                <input asp-for="MaxBorrowableBooks" class="form-control" placeholder="e.g. 5" />
                                <span asp-validation-for="MaxBorrowableBooks" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn-custom">💾 Save Profile</button>
                        </div>
                    </form>

                    <hr />
                    <div class="text-center">
                        <a asp-action="Index" class="text-muted">← Back to Profile List</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
