@model IEnumerable<LibraryMainApp.Models.LibraryProfile>

@{
    ViewData["Title"] = "Library Profile";
}

<h1>Library Profile</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table">
    <thead>
        <tr>
            <th>Library Name</th>
            <th>Admin</th>
            <th>Location</th>
            <th>Hours</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Loan Days</th>
            <th>Max Books</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td>@item.Admin?.Email</td>
                <td>@Html.DisplayFor(modelItem => item.Location)</td>
                <td>@Html.DisplayFor(modelItem => item.OperatingHours)</td>
                <td>@Html.DisplayFor(modelItem => item.Email)</td>
                <td>@Html.DisplayFor(modelItem => item.PhoneNumber)</td>
                <td>@Html.DisplayFor(modelItem => item.LoanDurationDays)</td>
                <td>@Html.DisplayFor(modelItem => item.MaxBorrowableBooks)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.LibraryID">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.LibraryID">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.LibraryID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
