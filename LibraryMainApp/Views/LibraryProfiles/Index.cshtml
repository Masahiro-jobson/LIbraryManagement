@model IEnumerable<LibraryMainApp.Models.LibraryProfile>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Admin)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Location)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OperatingHours)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PhoneNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LoanDurationDays)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MaxBorrowableBooks)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Admin.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Location)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.OperatingHours)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PhoneNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LoanDurationDays)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MaxBorrowableBooks)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.LibraryID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.LibraryID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.LibraryID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
