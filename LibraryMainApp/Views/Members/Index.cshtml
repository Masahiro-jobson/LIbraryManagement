@model IEnumerable<LibraryMainApp.Models.Member>

@{
    ViewData["Title"] = "Manage Members";
}

<div class="text-center mt-4 mb-3">
    <h2 class="text-primary">👥 Manage Members</h2>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert-custom-success mb-3">✅ @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert-custom-error mb-3">❌ @TempData["Error"]</div>
}

<div class="mb-3 text-end">
    <a asp-action="Create" class="btn-custom">➕ Add New Member</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table-custom">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Address</th>
                    <th>Registered</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.FirstName @item.LastName</strong></td>
                        <td>@item.Email</td>
                        <td>@item.PhoneNumber</td>
                        <td>@item.Address</td>
                        <td>@item.RegistrationDate.ToShortDateString()</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.MemberID"
                               class="btn btn-warning btn-sm" style="border-radius:20px; margin-right:4px;">✏️ Edit</a>
                            <a asp-action="Details" asp-route-id="@item.MemberID"
                               class="btn btn-info btn-sm text-white" style="border-radius:20px; margin-right:4px;">🔍 Details</a>
                            <a asp-action="Delete" asp-route-id="@item.MemberID"
                               class="btn btn-danger btn-sm" style="border-radius:20px;">🗑️ Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
