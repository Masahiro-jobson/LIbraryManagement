@model IEnumerable<LibraryMainApp.Models.Loan>
@{
    ViewData["Title"] = "Borrowing History";
}

<div class="container mt-4">
    <div class="text-center mb-3">
        <h2 class="text-primary">📜 Borrowing History</h2>
        <p class="text-muted">All books you have borrowed</p>
    </div>

    <div class="card">
        <div class="card-header bg-primary text-white">
            📚 Loan Records
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-custom mb-0">
                <thead>
                    <tr>
                        <th>Book Title</th>
                        <th>Author</th>
                        <th>Borrowed Date</th>
                        <th>Due Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var loan in Model)
                        {
                            <tr>
                                <td>@loan.Book?.Title</td>
                                <td>@loan.Book?.Author</td>
                                <td>@loan.LoanDate.ToString("dd MMM yyyy")</td>
                                <td>@loan.DueDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (DateTime.Now.Date > loan.DueDate.Date)
                                    {
                                        <span class="badge bg-danger">Overdue</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">Active</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center">No borrowing history found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        <a asp-controller="Member" asp-action="Dashboard" class="btn-custom">← Back to Dashboard</a>
    </div>
</div>
