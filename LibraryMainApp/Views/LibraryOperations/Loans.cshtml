@model IEnumerable<LibraryMainApp.Models.Loan>
@{
    ViewData["Title"] = "Loans";
}

<div class="text-center mt-4 mb-3">
    <h2 class="text-primary">📋 Loan Records</h2>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert-custom-success mb-3">✅ @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert-custom-error mb-3">❌ @TempData["Error"]</div>
}

<div class="card">
    <div class="card-header bg-primary text-white">
        🔄 Active Loans
    </div>
    <div class="card-body p-0">
        <table class="table table-striped table-custom mb-0">
            <thead>
                <tr>
                    <th>Loan ID</th>
                    <th>Member</th>
                    <th>Book</th>
                    <th>Loan Date</th>
                    <th>Due Date</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var loan in Model)
                {
                    <tr>
                        <td>@loan.LoanID</td>
                        <td>@loan.Member?.FirstName @loan.Member?.LastName</td>
                        <td>@loan.Book?.Title</td>
                        <td>@loan.LoanDate.ToString("dd MMM yyyy")</td>
                        <td>@loan.DueDate.ToString("dd MMM yyyy")</td>
                        <td>
                            <form asp-action="ReturnBook" method="post">
                                <input type="hidden" name="loanId" value="@loan.LoanID" />
                                <button class="btn-custom" style="background-color:#28a745;">Return Book</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
