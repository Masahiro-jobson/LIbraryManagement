@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center mt-4 mb-3">
    <h1 class="display-4 text-primary">📚 Library Management System</h1>
    <p class="text-muted">ICT272 - Web Design and Development</p>
</div>

<div class="alert alert-info alert-custom-success mb-4">
    👋 Welcome! Use the navigation above to browse books, manage loans, and view reports.
</div>

<!-- Group Details -->
<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        👥 Group Details
    </div>
    <div class="card-body p-0">
        <table class="table table-striped table-custom mb-0">
            <thead>
                <tr>
                    <th>Student Name</th>
                    <th>Student ID</th>
                    <th>Role</th>
                </tr>
            </thead>
            <tbody>
                <tr><td>Masahiro Togasaki</td><td>20027985</td><td>Database Logic / ERD / Full-stack support</td></tr>
                <tr><td>Hussain</td><td>12300164</td><td>Backend Justification, Security and Testing</td></tr>
                <tr><td>Danish Bashir</td><td>20028695</td><td>Frontend / UI</td></tr>
                <tr><td>Manpreet Singh</td><td>20029163</td><td>Introduction / User Manual / Conclusion</td></tr>
            </tbody>
        </table>
    </div>
</div>

<!-- New Arrivals -->
<div class="card mb-4">
    <div class="card-header bg-success text-white">
        🆕 New Arrivals
    </div>
    <div class="card-body">
        <div class="book-grid">
            @if (ViewBag.NewArrivals != null)
            {
                foreach (var book in ViewBag.NewArrivals)
                {
                    <div class="book-card">
                        <div class="book-title">📖 @book.Title</div>
                        <div class="book-author">✍️ @book.Author</div>
                        <div class="mt-2">
                            @if (book.AvailabilityStatus == "Available")
                            {
                                <span class="book-status-available">✅ Available</span>
                            }
                            else
                            {
                                <span class="book-status-borrowed">🔴 @book.AvailabilityStatus</span>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- Most Borrowed Books -->
<div class="card mb-4">
    <div class="card-header bg-warning">
        ⭐ Most Borrowed Books
    </div>
    <div class="card-body p-0">
        <table class="table table-striped table-custom mb-0">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Author</th>
                    <th>Status</th>
                    <th>Times Borrowed</th>
                </tr>
            </thead>
            <tbody>
                @if (ViewBag.MostBorrowed != null)
                {
                    foreach (var book in ViewBag.MostBorrowed)
                    {
                        <tr>
                            <td>@book.Title</td>
                            <td>@book.Author</td>
                            <td>
                                @if (book.AvailabilityStatus == "Available")
                                {
                                    <span class="book-status-available">✅ Available</span>
                                }
                                else
                                {
                                    <span class="book-status-borrowed">🔴 @book.AvailabilityStatus</span>
                                }
                            </td>
                            <td><span class="badge bg-primary">@book.Count times</span></td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="4" class="text-center">No borrowing data yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
