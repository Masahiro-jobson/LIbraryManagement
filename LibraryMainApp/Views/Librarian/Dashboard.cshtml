@{
    ViewData["Title"] = "Librarian Dashboard";
}

<div class="container mt-4">
    <h1 class="text-center text-primary">📚 Librarian Dashboard</h1>
    <p class="text-center lead">Welcome, @Context.Session.GetString("UserName")! Manage your library here.</p>

    <hr />

    <!-- Row 1: Book & Loan Management -->
    <div class="row justify-content-center">
        <div class="col-md-3">
            <div class="dashboard-card" onclick="location.href='@Url.Action("Index", "LibraryOperations")'">
                <div class="dashboard-icon">📖</div>
                <h5>View All Books</h5>
                <small>Manage book records</small>
            </div>
        </div>

        <div class="col-md-3">
            <div class="dashboard-card" onclick="location.href='@Url.Action("Loans", "LibraryOperations")'">
                <div class="dashboard-icon">🔄</div>
                <h5>Borrowing Transactions</h5>
                <small>Track loans and returns</small>
            </div>
        </div>

        <div class="col-md-3">
            <div class="dashboard-card" onclick="location.href='@Url.Action("Index", "Members")'">
                <div class="dashboard-icon">👥</div>
                <h5>Manage Members</h5>
                <small>View and edit members</small>
            </div>
        </div>

        <div class="col-md-3">
            <div class="dashboard-card" onclick="location.href='@Url.Action("Index", "Reports")'">
                <div class="dashboard-icon">📊</div>
                <h5>Reports</h5>
                <small>View library activity</small>
            </div>
        </div>
    </div>

    <!-- Row 2: Settings & Admin -->
    <div class="row justify-content-center mt-4">
        <div class="col-md-3">
            <div class="dashboard-card" onclick="location.href='@Url.Action("Index", "LibraryProfiles")'">
                <div class="dashboard-icon">🏛️</div>
                <h5>Library Profile</h5>
                <small>Manage library details</small>
            </div>
        </div>

        <div class="col-md-3">
            <div class="dashboard-card" onclick="location.href='@Url.Action("Index", "Feedbacks")'">
                <div class="dashboard-icon">⭐</div>
                <h5>Member Feedback</h5>
                <small>View book ratings</small>
            </div>
        </div>

        <div class="col-md-3">
            <div class="dashboard-card" onclick="location.href='@Url.Action("Index", "Fines")'">
                <div class="dashboard-icon">💰</div>
                <h5>Fines</h5>
                <small>Manage overdue fines</small>
            </div>
        </div>

        <div class="col-md-3">
            <div class="dashboard-card" onclick="location.href='@Url.Action("Logout", "Account")'">
                <div class="dashboard-icon">🚪</div>
                <h5>Logout</h5>
                <small>Sign out of system</small>
            </div>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header bg-info text-white">
            <h5>📊 Recent Library Activity</h5>
        </div>
        <div class="card-body">
            <table class="table table-striped table-custom">
                <thead>
                    <tr>
                        <th>Activity</th>
                        <th>Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.RecentLoans != null)
                    {
                        foreach (var loan in ViewBag.RecentLoans)
                        {
                            <tr>
                                <td>"@loan.Book?.Title" borrowed by @loan.Member?.FirstName @loan.Member?.LastName</td>
                                <td>@loan.LoanDate.ToString("dd MMM yyyy")</td>
                                <td><span class="badge bg-warning">Active</span></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
