@model LibraryMainApp.Models.Book

@{
    ViewData["Title"] = "Delete Book";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-danger">
                <div class="card-header bg-danger text-white text-center">
                    <h3>🗑️ Delete Book</h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        ⚠️ Are you sure you want to delete this book? This action cannot be undone.
                    </div>

                    <div class="mb-3 text-center">
                        @if (!string.IsNullOrEmpty(Model.CoverImagePath))
                        {
                            <img src="@Model.CoverImagePath" alt="@Model.Title"
                                 style="width:100px; border-radius:8px; margin-bottom:10px;" />
                        }
                    </div>

                    <dl class="row">
                        <dt class="col-sm-4">Title</dt>
                        <dd class="col-sm-8"><strong>@Model.Title</strong></dd>

                        <dt class="col-sm-4">Author</dt>
                        <dd class="col-sm-8">@Model.Author</dd>

                        <dt class="col-sm-4">Published Year</dt>
                        <dd class="col-sm-8">@Model.PublishedYear</dd>

                        <dt class="col-sm-4">Genre</dt>
                        <dd class="col-sm-8">@Model.Genre</dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">@Model.AvailabilityStatus</dd>
                    </dl>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="ISBN" />
                        <div class="d-flex gap-2 mt-3">
                            <button type="submit" class="btn btn-danger" style="border-radius:25px; flex:1;">🗑️ Yes, Delete</button>
                            <a asp-action="Index" class="btn btn-secondary" style="border-radius:25px; flex:1; text-align:center; line-height:1.8;">← Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
