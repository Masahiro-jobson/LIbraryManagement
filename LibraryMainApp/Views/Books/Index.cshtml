@model IEnumerable<LibraryMainApp.Models.Book>

@{
    ViewData["Title"] = "Manage Books";
}

<div class="text-center mt-4 mb-3">
    <h2 class="text-primary">📚 Manage Books</h2>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert-custom-success mb-3">✅ @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert-custom-error mb-3">❌ @TempData["Error"]</div>
}

<div class="mb-3 text-end">
    <a asp-action="Create" class="btn-custom">➕ Add New Book</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table-custom">
            <thead>
                <tr>
                    <th>Cover</th>
                    <th>Title</th>
                    <th>Author</th>
                    <th>Year</th>
                    <th>Genre</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(item.CoverImagePath))
                            {
                                <img src="@item.CoverImagePath" alt="@item.Title"
                                     style="width:48px; height:64px; object-fit:cover; border-radius:6px;" />
                            }
                            else
                            {
                                <div style="width:48px; height:64px; background:#e9ecef; border-radius:6px; display:flex; align-items:center; justify-content:center; font-size:22px;">📖</div>
                            }
                        </td>
                        <td><strong>@item.Title</strong></td>
                        <td>@item.Author</td>
                        <td>@item.PublishedYear</td>
                        <td><span class="badge bg-secondary">@item.Genre</span></td>
                        <td>
                            @if (item.AvailabilityStatus == "Available")
                            {
                                <span class="book-status-available">✅ Available</span>
                            }
                            else
                            {
                                <span class="book-status-borrowed">🔴 @item.AvailabilityStatus</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.ISBN"
                               class="btn btn-warning btn-sm" style="border-radius:20px; margin-right:4px;">✏️ Edit</a>
                            <a asp-action="Details" asp-route-id="@item.ISBN"
                               class="btn btn-info btn-sm text-white" style="border-radius:20px; margin-right:4px;">🔍 Details</a>
                            <a asp-action="Delete" asp-route-id="@item.ISBN"
                               class="btn btn-danger btn-sm" style="border-radius:20px;">🗑️ Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
